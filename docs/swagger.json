{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "API Gateway for the Gourd",
        "title": "Gourd API",
        "contact": {},
        "version": "0.1"
    },
    "basePath": "/",
    "paths": {
        "/counter": {
            "get": {
                "description": "Returns the current value of the counter",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "counter"
                ],
                "summary": "Get counter value",
                "responses": {
                    "200": {
                        "description": "Current counter value",
                        "schema": {
                            "type": "integer"
                        }
                    }
                }
            }
        },
        "/documents/file": {
            "post": {
                "description": "Uploads a document file and applies the specified processing rules to it, returning the processed binary content",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/octet-stream"
                ],
                "tags": [
                    "documents"
                ],
                "summary": "Process a document file",
                "parameters": [
                    {
                        "type": "file",
                        "description": "Document file to process",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        },
                        "collectionFormat": "multi",
                        "description": "List of rule IDs to apply",
                        "name": "rule",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Processed document",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "400": {
                        "description": "Invalid request body",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "File processing error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/documents/raw": {
            "post": {
                "description": "Applies the specified processing rules to raw text content of a given file type and returns the processed output. Currently only \"markdown\" is supported as a file type",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "documents"
                ],
                "summary": "Process raw text content",
                "parameters": [
                    {
                        "description": "Raw content, file type and rules to apply",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/gateway.ProcessRawRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Unsupported file type",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request body",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Processing error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Returns a simple message confirming that the service is up and running",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "service"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "Healthy :)",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/rules/{type}": {
            "get": {
                "description": "Returns the registry of document processing rules grouped by category, filtered by the file type from the path. Each category contains its name and a list of rules; each rule has an id, name, description and default enabled state. Only rules that have an adapter for the requested file type are included. Categories without applicable rules are still returned, with an empty rules list.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "rules"
                ],
                "summary": "List available rules for a file type",
                "parameters": [
                    {
                        "type": "string",
                        "description": "File type the rules are requested for",
                        "name": "type",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of rule categories with their rules",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/gateway.CategoryDTO"
                            }
                        }
                    },
                    "404": {
                        "description": "Rule registry contains no categories (response body: {\\\"error\\\": \\\"no rules found for file type\\\"})",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "gateway.CategoryDTO": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "rules": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/gateway.RuleDTO"
                    }
                }
            }
        },
        "gateway.ProcessRawRequest": {
            "type": "object",
            "properties": {
                "rules": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "text": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "gateway.RuleDTO": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "enabled_by_default": {
                    "type": "boolean"
                },
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                }
            }
        }
    }
}