{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "API Gateway for the Gourd",
        "title": "Gourd API",
        "contact": {},
        "version": "0.1"
    },
    "basePath": "/",
    "paths": {
        "/counter": {
            "get": {
                "description": "Returns the current value of the counter",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "counter"
                ],
                "summary": "Get counter value",
                "responses": {
                    "200": {
                        "description": "Current counter value",
                        "schema": {
                            "type": "integer"
                        }
                    }
                }
            }
        },
        "/documents/file": {
            "post": {
                "description": "Uploads a domain file and applies the specified processing rules to it, returning the processed binary content.\nThe file type must be given in the file_type field.\nAt least one rule must be specified in the rules field.\nProcessing metadata is returned in the X-Process-Meta response header: a base64-encoded JSON object with the file type and the results of the applied rules,\ne.g. {\"file_type\":\"docx\",\"results\":[{\"key\":\"some_rule\",\"result\":\"...\"}]}.\nThe shape of each \"result\" depends on the rule that produced it.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/octet-stream"
                ],
                "tags": [
                    "documents"
                ],
                "summary": "Process a domain file",
                "parameters": [
                    {
                        "type": "file",
                        "description": "Document file to process",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Type of the uploaded domain",
                        "name": "file_type",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "multi",
                        "description": "List of rule IDs to apply (at least one required)",
                        "name": "rules",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Processed domain",
                        "schema": {
                            "type": "file"
                        },
                        "headers": {
                            "X-Process-Meta": {
                                "type": "string",
                                "description": "Base64-encoded JSON with processing metadata (file_type, results)"
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request body or no rules specified",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "File read or processing error (including unsupported file type)",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/documents/raw": {
            "post": {
                "description": "Applies the specified processing rules to raw text content of a given file type. Currently only \"markdown\" is supported as a file type.\nAt least one rule must be specified in the rules field.\nThe response contains the processed text in the \"output\" field and the results of the applied rules in the \"result\" field.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "documents"
                ],
                "summary": "Process raw text content",
                "parameters": [
                    {
                        "description": "Raw content, file type and rules to apply (rules must not be empty)",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/gateway.ProcessRawRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Processed output and rule results, e.g. {\\\"output\\\": \\\"...\\\", \\\"result\\\": [{\\\"key\\\": \\\"some_rule\\\", \\\"result\\\": \\\"...\\\"}]}",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Invalid request body or no rules specified",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Processing error (including unsupported file type)",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Returns a simple message confirming that the service is up and running",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "service"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "Healthy :)",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/rules": {
            "get": {
                "description": "Returns the registry of domain processing rules grouped by category.\nEach category contains its name and a list of rules; each rule has an id, name, description, default enabled state and the list of file formats it is available for.\nThe categories are returned under the `categories` key of the response object.\nIf the rules cannot be built from the registry, the endpoint responds with 500.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "rules"
                ],
                "summary": "List available rules",
                "responses": {
                    "200": {
                        "description": "Rule categories with their rules (response body: {\\\"categories\\\": [...]})",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/definitions/dto.Category"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Failed to build rules from the registry (response body: {\\\"error\\\": \\\"...\\\"})",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.Category": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "rules": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.Rule"
                    }
                }
            }
        },
        "dto.Rule": {
            "type": "object",
            "properties": {
                "available_formats": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "description": {
                    "type": "string"
                },
                "enabled_by_default": {
                    "type": "boolean"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "gateway.ProcessRawRequest": {
            "type": "object",
            "required": [
                "type"
            ],
            "properties": {
                "rules": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "text": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        }
    }
}